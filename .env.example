# Core application
APP_ENV=development
APP_PORT=8000
APP_SECRET=change-me

# PostgreSQL / PostGIS
POSTGRES_DB=feste_db
POSTGRES_USER=feste_user
POSTGRES_PASSWORD=feste_password
DATABASE_URL=postgresql+psycopg://feste_user:feste_password@db:5432/feste_db

# Redis (optional for cache / jobs)
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Feste Italia

# Admin / security
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
